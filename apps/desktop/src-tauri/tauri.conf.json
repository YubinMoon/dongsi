{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dongsi",
  "mainBinaryName": "dongsi",
  "version": "0.1.0",
  "identifier": "com.dongsi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "dongsi",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#0d0e11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "publisher": "YubinMoon",
    "copyright": "Copyright (c) 2026 YubinMoon",
    "license": "MIT",
    "homepage": "https://github.com/YubinMoon/dongsi",
    "shortDescription": "dongsi 화면 공유",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "Korean",
          "English"
        ]
      }
    }
  }
}
